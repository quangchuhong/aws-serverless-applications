########################################
# cp terraform.tfvars.example terraform.tfvars
########################################

region = "ap-southeast-1"
# TOI THIEU 2 AZ. Moi AZ them ~$318/thang (NAT ~$33 + firewall
# endpoint ~$285). Doi lai: mot AZ hong khong lam sap ca mang.
availability_zones = ["ap-southeast-1a", "ap-southeast-1b"]

########################################
# TAG CHUAN
#
# Bon tag nay duoc gan vao MOI resource qua default_tags, va la
# nhung tag duoc bat cost allocation o landing-zone/billing-guard.
#
# Gan tag ma khong bat cost allocation -> Cost Explorer khong group duoc.
# Bat cost allocation ma khong gan tag -> khong co du lieu de group.
# Phai co CA HAI.
########################################

project     = "lz-net"
cost_center = "CC-0000"                # doi thanh ma phong ban that
owner       = "platform@example.com"   # doi thanh email that
environment = "sandbox"                # dev | staging | prod | sandbox

########################################
# BUOC 1 — CHE DO RE (~$0.34/gio)
# Kiem chung: egress tap trung, spoke khong co IGW/NAT, ingress NLB.
# Chua co firewall nen chua kiem chung duoc east-west.
########################################

enable_firewall       = false
enable_ingress        = true
enable_test_instances = true

########################################
# BUOC 2 — BAT FIREWALL, che do ALERT (~$0.74/gio)
# Firewall thanh tra va GHI LOG nhung KHONG chan.
# Day la che do phai dung dau tien khi trien khai that.
########################################

# enable_firewall = true
# firewall_mode   = "alert"

########################################
# BUOC 3 — CHUYEN SANG DROP
# Gio firewall chan that. Kiem chung:
#   - port 80 giua hai spoke: THONG  (co rule)
#   - port 22 giua hai spoke: CHAN   (khong co rule, du SG da mo)
#   - domain ngoai allowlist: CHAN
########################################

# enable_firewall = true
# firewall_mode   = "drop"

########################################
# BUOC 4 — Thu mo/dong ket noi VPC-to-VPC
#
# Them mot dong vao day = mo them mot luong.
# Xoa mot dong = dong luong do.
# KHONG can sua route nao ca.
########################################

# east_west_rules = [
#   {
#     from_cidr = "10.10.0.0/16"
#     to_cidr   = "10.20.0.0/16"
#     port      = 80
#     note      = "app-dev goi app-prod qua HTTP"
#   },
#   {
#     from_cidr = "10.10.0.0/16"
#     to_cidr   = "10.20.0.0/16"
#     port      = 22
#     note      = "them dong nay thi SSH cung thong"
#   },
# ]

########################################
# BUOC 5 — Interface endpoint trong security VPC (+$0.03/gio)
########################################

# enable_interface_endpoints  = true
# interface_endpoint_services = ["ssm", "ssmmessages", "ec2messages"]

########################################
# BUOC 6 — CloudFront + AWS WAF (+~$0.01/gio, gan nhu mien phi)
#
# Dung hostname mac dinh *.cloudfront.net:
#   KHONG can mua domain, KHONG can Route 53, KHONG can ACM.
#
# Bat len cung KHOA ORIGIN: goi thang vao NLB se bi chan,
# chi CloudFront moi vao duoc.
#
# LUU Y: apply cham them ~5-15 phut, destroy cham them ~15-20 phut
#        vi CloudFront phai disable truoc khi delete.
########################################

# enable_cdn = true
# waf_mode   = "count"    # chi dem, chua chan - dung dau tien

# Sau khi xem CloudWatch metric thay khong chan nham thi doi sang:
# waf_mode = "block"      # gio moi chan that
#   -> test: curl "https://<cloudfront>/?id=1%27%20OR%20%271%27=%271"
#      phai tra ve 403

# waf_rate_limit  = 2000            # request/5 phut moi IP
# cdn_price_class = "PriceClass_200" # gom chau A, do tre tot hon tu VN

########################################
# PHASE SAU — Palo Alto + F5
#
# Code da viet san trong appliances.tf, mac dinh TAT.
#
# Kiem chung code ngay bay gio ma khong tao gi:
#   ./plan-check.sh
#
# Khi co license Marketplace thi bo comment ba dong duoi.
# Chi phi khi bat: ~$3-6/gio (license tinh theo gio).
########################################

# enable_appliances = true
# pa_ami_id         = ""   # de trong = tu tim tren Marketplace
# f5_ami_id         = ""

# Muon PLAN ma chua subscribe Marketplace: dat AMI bat ky
# pa_ami_id = "ami-xxxxxxxxxxxx"
# f5_ami_id = "ami-xxxxxxxxxxxx"

# Production dung 443 (F5 terminate TLS), demo dung 80
# nlb_listener_port = 443

########################################
# GIAM CHI PHI: bot con mot spoke (-$0.05/gio)
# Nhung se khong demo duoc east-west nua.
########################################

# spokes = {
#   "app-dev" = { cidr = "10.10.0.0/16" }
# }

########################################
# SPOKE O ACCOUNT KHAC - VPC + attachment + route tu dong
#
# Spoke khai account_id se duoc tao o ACCOUNT DO qua CloudFormation
# StackSet: VPC, subnet, route table, route 0.0.0.0/0 -> TGW, va TGW
# attachment. Terraform o day tim lai attachment theo tag Name roi noi
# vao route table cua hub - buoc do CHI CHU SO HUU TGW lam duoc.
#
# ---------------------------------------------------------------
# CHAY TU ACCOUNT NETWORK - KHONG PHAI MANAGEMENT.
#
# Demo chi co MOT provider, nen chay tu management se tao TOAN BO hub
# (TGW, security VPC, egress, firewall, NAT, NLB) trong management
# account - noi SCP khong bao gio ap duoc.
#
# Thay vao do, dang ky account network lam delegated administrator cua
# StackSets. Chay MOT LAN tu management:
#
#   aws organizations register-delegated-administrator \
#     --service-principal member.org.stacksets.cloudformation.amazonaws.com \
#     --account-id <network-account-id>
#
# ---------------------------------------------------------------
# GIU IT NHAT MOT SPOKE LOCAL neu con muon chay verify.sh.
#
# Template StackSet tao VPC + attachment, KHONG tao EC2. Ma verify.sh
# muc 7 va 8 - hai muc duy nhat do LUU LUONG THAT - chay lenh tren EC2
# qua SSM. Chuyen het spoke sang remote thi mat luon EC2 thu, ban ghi
# PHZ, va target cua NLB.
#
# ---------------------------------------------------------------
# ACCOUNT MOI CAN HAI LAN APPLY. Lan dau StackSet tao attachment; data
# source doc truoc do nen chua thay, va check "remote_attachments_wired"
# se bao 0/N. Chay apply lan hai la noi xong.
#
# Attachment ton tai ma khong thuoc route table nao thi State van la
# 'available', khong loi, va khong mot goi tin nao di qua.
########################################

# network_account_is_stackset_delegated_admin = true

# aws organizations describe-organization --query Organization.Arn --output text
# organization_arn = "arn:aws:organizations::<management-id>:organization/o-xxxxxxxxxx"

# spokes = {
#   "app-dev"  = { cidr = "10.10.0.0/16" }                                # local
#   "app-prod" = { cidr = "10.20.0.0/16", account_id = "761558631239" }   # account khac
# }

# CIDR khai tuong minh va di qua review - trung CIDR trong luoi TGW thi
# route table khong phan biet duoc hai spoke, va sua thi phai xoa VPC.
# Bang cap phat o doc 17 muc 3:
#   NonProd  10.10.0.0/14   Prod  10.20.0.0/14   Sandbox  10.60.0.0/14
