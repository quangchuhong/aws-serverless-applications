#!/bin/bash
# strongSwan gia lap thiet bi VPN cua doi tac.
#
# CHAY TREN UBUNTU. Day la may duy nhat trong ca bo khong phai AL2023,
# vi AL2023 khong co goi strongswan trong repo. Moi lenh goi trinh quan
# ly goi o day la apt-get - them mot dong dnf/yum vao la hong.
#
# Sinh tu partner-sim.tf. DUNG sua tren may - lan thay instance ke
# tiep se ghi de.
#
# Moi thu ghi vao /var/log/user-data.log. Khi tunnel khong len, day la
# file doc dau tien:
#   aws ssm start-session --target <id> ; sudo cat /var/log/user-data.log
exec > >(tee -a /var/log/user-data.log) 2>&1
set -x

########################################
# 1. Nhan goi tin khong phai cua minh
#
# Ba dong nay hay bi quen, va thieu chung thi duong ham LEN BINH
# THUONG con goi tin thi bien mat. Trieu chung doc nhu loi dinh tuyen
# o phia AWS.
########################################
cat > /etc/sysctl.d/99-vpn.conf <<'SYSCTL'
net.ipv4.ip_forward = 1
net.ipv4.conf.all.accept_redirects = 0
net.ipv4.conf.all.send_redirects = 0
net.ipv4.conf.all.rp_filter = 0
net.ipv4.conf.default.rp_filter = 0
SYSCTL
sysctl -p /etc/sysctl.d/99-vpn.conf

########################################
# 1a. Cai goi - UBUNTU, khong phai Amazon Linux
#
# AL2023 KHONG CO goi strongswan: `dnf install strongswan` tra ve
# "Unable to find a match". AWS cat phan lon goi mang khoi repo do.
# Nen may nay - va chi may nay trong ca bo - chay Ubuntu.
#
# DPkg::Lock::Timeout: cloud-init va unattended-upgrades cung chay luc
# may vua len va giu khoa dpkg. Khong co dong nay thi apt-get chet ngay
# voi "Could not get lock", va trieu chung phia AWS lai la hai duong
# ham DOWN - khong lien quan gi toi IPsec.
########################################
export DEBIAN_FRONTEND=noninteractive
APT="apt-get -o DPkg::Lock::Timeout=600 -y"

$APT update
$APT install strongswan strongswan-starter netcat-openbsd dnsutils tcpdump || {
  echo "KHONG CAI DUOC strongswan."
  echo "Kiem: apt-cache policy strongswan"
  echo "Neu day khong phai Ubuntu, kiem var.partner_sim_ami_ssm_parameter."
  exit 1
}

# apt-get co the tra ve 0 ma goi van khong o trang thai 'installed'.
# dpkg -s la thu duy nhat biet chac.
dpkg -s strongswan >/dev/null 2>&1 || {
  echo "apt bao thanh cong nhung strongswan KHONG co tren may."
  echo "Day la nhanh im lang nhat cua ca script: khong co daemon thi"
  echo "khong co goi IKE nao roi khoi may, va phia AWS bao ca hai"
  echo "duong ham DOWN voi StatusMessage RONG - dung trieu chung nay."
  exit 1
}

# Duong dan khac nhau theo ban dong goi:
#   Ubuntu/Debian  /etc/ipsec.conf, /etc/strongswan.conf
#   Fedora/RHEL    /etc/strongswan/...
CONF_DIR=/etc/strongswan
[ -d "$CONF_DIR" ] || CONF_DIR=/etc

########################################
# 1b. install_routes = no
#
# Day la mot tuy chon cua charon, nam trong strongswan.conf - KHONG
# phai trong ipsec.conf. Viet no vao ipsec.conf thi khong co tac dung
# nao va cung khong co loi nao.
#
# Thieu no, voi leftsubnet=0.0.0.0/0 o muc 2, charon tu them mot route
# 0.0.0.0/0 vao bang 220 ngay khi SA len. May mat duong ra Internet:
# SSM rot, va ban mat luon duong vao de xem vi sao.
#
# Ta tu quan ly route o muc 4, va chi cho hai dai duoc cong bo.
########################################
if ! grep -q "install_routes" "$CONF_DIR/strongswan.conf" 2>/dev/null; then
  cat >> "$CONF_DIR/strongswan.conf" <<'SWANCONF'

charon {
    install_routes = no
}
SWANCONF
fi

########################################
# 2. Cau hinh duong ham
#
# VTI (route-based), khong phai policy-based.
#
# AWS luon chay route-based o phia ho. Ghep mot dau policy-based vao
# thi IKE len duoc nhung traffic selector khong khop, va ket qua la
# SA co ma khong goi tin nao qua - kieu hong te nhat vi moi trang thai
# deu bao "established".
#
# mark=100/200: danh dau goi tin de gan vao dung interface vti.
#
# Viec chan charon tu them route nam o MUC 1b, trong strongswan.conf.
# Truoc day chu thich o day noi "install_routes=no" nhu the no duoc
# dat trong chinh file ipsec.conf ben duoi - va no khong he co trong
# do. Mot tuy chon cua charon viet nham vao ipsec.conf khong sinh loi
# nao ca, no chi im lang khong co tac dung.
########################################
cat > "$CONF_DIR/ipsec.conf" <<'IPSEC'
config setup
    charondebug="ike 1, knl 1, cfg 0"
    uniqueids=no

conn %default
    type=tunnel
    keyexchange=ikev2
    authby=psk
    # Bo thuat toan AWS chap nhan cho ca hai pha
    ike=aes128-sha1-modp1024,aes256-sha256-modp2048!
    esp=aes128-sha1-modp1024,aes256-sha256-modp2048!
    ikelifetime=8h
    lifetime=1h
    # AWS gui DPD; khong tra loi thi ho ha tunnel xuong sau ~30s
    dpddelay=10s
    dpdtimeout=30s
    dpdaction=restart
    keyingtries=%forever
    # Toan bo luu luong duoc phep vao SA; viec chon dai nao di duong
    # ham nao la cua ROUTE o muc 4, khong phai cua traffic selector
    leftsubnet=0.0.0.0/0
    rightsubnet=0.0.0.0/0
    left=%defaultroute
    leftid=${local_id}
    auto=start
    installpolicy=yes

conn Tunnel1
    right=${tunnel1_address}
    rightid=${tunnel1_address}
    mark=100

conn Tunnel2
    right=${tunnel2_address}
    rightid=${tunnel2_address}
    mark=200
IPSEC

cat > "$CONF_DIR/ipsec.secrets" <<'SECRETS'
${local_id} ${tunnel1_address} : PSK "${tunnel1_psk}"
${local_id} ${tunnel2_address} : PSK "${tunnel2_psk}"
SECRETS
chmod 600 "$CONF_DIR/ipsec.secrets"

########################################
# 3. Interface VTI
#
# Mot cai moi duong ham. key/mark phai khop voi mark= trong ipsec.conf,
# neu khong thi goi tin ra khoi vti se khong duoc ma hoa - di ra
# Internet dang tho va bien mat.
########################################
modprobe ip_vti || {
  echo "KHONG NAP DUOC module ip_vti - khong tao duoc interface duong ham."
  exit 1
}

setup_vti() {
  local name=$1 mark=$2 local_ip=$3 remote_ip=$4 inside_local=$5 inside_remote=$6

  ip link del "$name" 2>/dev/null || true
  ip tunnel add "$name" mode vti local "$local_ip" remote "$remote_ip" key "$mark" || {
    echo "KHONG TAO DUOC $name."
    return 1
  }
  ip addr add "$inside_local" remote "$inside_remote" dev "$name"
  ip link set "$name" up mtu 1436

  # Tat policy tren chinh vti - neu khong, goi tin bi kiem tra hai lan
  sysctl -w "net.ipv4.conf.$name.disable_policy=1"
  sysctl -w "net.ipv4.conf.$name.rp_filter=0"
}

PRIVATE_IP=$(curl -s -H "X-aws-ec2-metadata-token: $(curl -s -X PUT \
  -H 'X-aws-ec2-metadata-token-ttl-seconds: 300' \
  http://169.254.169.254/latest/api/token)" \
  http://169.254.169.254/latest/meta-data/local-ipv4)

setup_vti vti1 100 "$PRIVATE_IP" "${tunnel1_address}" "${tunnel1_cgw_inside}" "${tunnel1_vgw_inside}"
setup_vti vti2 200 "$PRIVATE_IP" "${tunnel2_address}" "${tunnel2_cgw_inside}" "${tunnel2_vgw_inside}"

########################################
# 4. Route - CHI hai dai duoc cong bo
#
# Day la lop kiem soat THU NHAT trong ba lop cua doc 16, va no nam o
# phia doi tac chu khong phai phia ban. May nay khong co route toi
# 10.10.0.0/16 hay 10.20.0.0/16, nen no khong the goi toi spoke ke ca
# khi moi route table ben AWS deu cho phep.
#
# Voi doi tac that, dieu tuong duong dat duoc bang static route hoac
# BGP filter tren thiet bi cua HO - va do la ly do phai ghi vao hop
# dong ky thuat, khong chi noi mieng.
#
# metric khac nhau: vti1 uu tien, vti2 du phong. AWS chi bao dam mot
# tunnel UP tai mot thoi diem trong che do static.
########################################
#
# `src` LA BAT BUOC, khong phai trang tri.
#
# Route dat len mot interface point-to-point ma khong khai src thi
# nhan tu chon dia chi nguon = dia chi dau tien cua chinh interface do
# - o day la 169.254.100.2, dia chi TRONG duong ham.
#
# Duong ham van len, goi tin van di, NLB van nhan duoc ket noi. Nhung
# no tra loi ve 169.254.100.2, va bang route cua VPC khong co duong
# nao toi dai do: route tinh cua VPN chi cong bo 172.16.0.0/16. Goi
# tra loi bi vut, curl treo roi tra ve 000.
#
# Trieu chung doc y het "khong co duong" trong khi moi route deu dung.
# Chieu di hoan hao, chieu ve khong ton tai.
%{ for cidr in remote_cidrs ~}
ip route replace ${cidr} dev vti1 src "$PRIVATE_IP" metric 100
ip route append ${cidr} dev vti2 src "$PRIVATE_IP" metric 200
%{ endfor ~}

########################################
# 4b. Cho EIP duoc gan XONG roi moi khoi dong charon
#
# Terraform tao instance TRUOC, gan EIP SAU. Trong khoang giua do may
# van co mot IP cong khai - cai AWS tu phat khi bat
# associate_public_ip_address - va no KHONG phai EIP.
#
# charon voi auto=start ban goi IKE ngay khi len. Neu no ban trong
# khoang do, goi tin toi VPN endpoint mang dia chi nguon la IP tam.
# AWS khong co customer gateway nao khop dia chi do nen vut goi tin
# ma khong ghi gi ca: ca hai duong ham DOWN, StatusMessage RONG.
#
# Trieu chung nay khong the phan biet voi "daemon khong chay" neu chi
# nhin tu phia AWS - do la ly do phai chan o day chu khong doan sau.
########################################
imds() {
  local token
  token=$(curl -s -X PUT -H 'X-aws-ec2-metadata-token-ttl-seconds: 300' \
    http://169.254.169.254/latest/api/token)
  curl -s -H "X-aws-ec2-metadata-token: $token" \
    "http://169.254.169.254/latest/meta-data/$1"
}

EXPECTED_EIP="${local_id}"
for _ in $(seq 1 60); do
  CURRENT_IP=$(imds public-ipv4)
  [ "$CURRENT_IP" = "$EXPECTED_EIP" ] && break
  echo "cho EIP: dang la '$CURRENT_IP', can '$EXPECTED_EIP'"
  sleep 5
done

if [ "$CURRENT_IP" != "$EXPECTED_EIP" ]; then
  echo "SAU 5 PHUT EIP VAN CHUA DUOC GAN."
  echo "leftid trong ipsec.conf la $EXPECTED_EIP nhung may dang ra"
  echo "Internet bang $CURRENT_IP - IKE se khong bao gio khop."
  echo "Kiem aws_eip_association.partner_sim o phia Terraform."
  exit 1
fi
echo "EIP da gan: $CURRENT_IP"

########################################
# 4c. Ten unit khac nhau theo ban dong goi
#
# Debian: strongswan-starter. Fedora/AL2023: strongswan.
#
# Truoc day cho nay viet "enable A || enable B || true", va dau `true`
# o cuoi nuot MOI that bai: khong tim thay unit nao thi script van chay
# tiep va bao thanh cong. Tim ten TRUOC roi hong to neu khong co.
########################################
UNIT=""
for u in strongswan strongswan-starter charon-systemd; do
  if systemctl list-unit-files | grep -q "^$u\.service"; then
    UNIT=$u
    break
  fi
done

if [ -z "$UNIT" ]; then
  echo "KHONG TIM THAY UNIT systemd nao cua strongswan."
  echo "Cac unit co chua chu swan tren may nay:"
  systemctl list-unit-files | grep -i swan || echo "  (khong co cai nao)"
  exit 1
fi
echo "Dung unit: $UNIT"

systemctl enable "$UNIT"
systemctl restart "$UNIT"

########################################
# 5. Dung lai VTI sau khi khoi dong lai
#
# ip tunnel khong ton tai qua reboot. Khong co unit nay thi tunnel len
# nhung khong co interface de gan route - va trang thai do doc y het
# nhu "VPN hong" trong khi IPsec hoan toan binh thuong.
########################################
cp /var/lib/cloud/instance/user-data.txt /usr/local/bin/setup-vpn.sh 2>/dev/null || true
chmod +x /usr/local/bin/setup-vpn.sh 2>/dev/null || true

cat > /etc/systemd/system/vpn-vti.service <<'UNIT'
[Unit]
Description=Dung lai interface VTI va route sau khi khoi dong
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/local/bin/setup-vpn.sh
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable vpn-vti.service || true

########################################
# 6. Lenh kiem chung, de san tren may
#
# Dat thanh script de nguoi vao qua SSM go mot chu la xong, thay vi
# nho sau lenh khac nhau luc 2 gio sang.
########################################
# %%{http_code} PHAI viet hai dau phan tram.
#
# Terraform doc no la mo mot directive, cung ho voi dau do-la-ngoac.
# Viet mot dau phan tram thi templatefile() hong ngay o PLAN, truoc khi
# co resource nao duoc tao, va thong bao noi ve "Invalid template
# control keyword" chu khong noi day la chuoi dinh dang cua curl.
#
# LUU Y CHO NGUOI SUA FILE NAY: file .tftpl KHONG CO CHU THICH. Moi
# dong deu la van ban cua template, ke ca dong bat dau bang #. Viet mot
# dau do-la-ngoac trong chu thich de GIAI THICH cu phap do se lam
# template hong y het nhu viet no that.
#
# Chinh dong nay tung lam hong plan mot lan vi ly do do.
#
# Cung ho voi loi 69: mot chuoi hoan toan hop le trong ngu canh cua no,
# dat vao mot ngu canh khac thi thanh cu phap cua ngon ngu khac.
cat > /usr/local/bin/vpn-check <<'CHK'
#!/bin/bash
echo "=== IPsec SA ==="
# Tren Ubuntu lenh `strongswan` co the ton tai, THOAT 0, va khong in gi.
# Nen `A || B` khong bao gio chay toi B, va muc nay hien ra RONG - doc
# nhu "khong co SA nao" trong khi ca hai dang chay.
SA=$(strongswan statusall 2>/dev/null)
[ -n "$SA" ] || SA=$(ipsec statusall 2>&1)
echo "$SA"
echo
echo "=== Dia chi nguon di ra duong ham ==="
echo "  (PHAI la dia chi rieng cua may, KHONG phai 169.254.x trong duong ham)"
ip route get 10.9.100.1 2>/dev/null | head -1 || true
echo
echo "=== Interface VTI ==="
ip -brief addr show type vti
echo
echo "=== Route qua duong ham ==="
ip route show | grep -E 'vti' || echo "(khong co route nao gan vao vti)"
echo
echo "=== Goi dich vu ban cong bo ==="
echo "  (200 = ca tuyen thong: IPsec -> VGW -> NLB -> TGW -> firewall -> spoke)"
curl -s -m 5 -o /dev/null -w "  NLB tra ve %%{http_code}\n" "http://__NLB__:__PORT__/" \
  || echo "  NLB khong tra loi - xem IPsec SA o tren truoc"
echo
echo "=== Lop cach ly - PHAI THAT BAI ==="
echo "  May nay khong duoc phep goi thang toi spoke."
# `curl -s` that bai thi KHONG IN GI. Im lang cua that bai doc y het
# im lang cua thanh cong, nen phai hoi ma HTTP va ma thoat - khong
# duoc doc bang mat.
ISO=$(curl -sm 5 -o /dev/null -w '%%{http_code}' "http://__SPOKE__/" 2>/dev/null)
RC=$?
if [ "$ISO" = "000" ] || [ "$RC" -ne 0 ]; then
  echo "  DAT: khong goi duoc __SPOKE__ (http=$ISO, ma thoat=$RC)"
else
  echo "  LOI: goi THANG duoc toi __SPOKE__ va nhan http=$ISO"
  echo "  Lop kiem soat thu nhat thung. Kiem route tren may nay:"
  echo "  chi duoc co dai NAT va dai NLB, khong duoc co dai spoke."
fi
CHK
sed -i "s|__NLB__|${nlb_dns}|" /usr/local/bin/vpn-check
sed -i "s|__PORT__|${service_port}|" /usr/local/bin/vpn-check
sed -i "s|__SPOKE__|${spoke_ip}|g" /usr/local/bin/vpn-check
chmod +x /usr/local/bin/vpn-check

########################################
# 7. Noi ngay ket qua, trong chinh file log nay
#
# Khong co doan nay thi user-data.log ket thuc bang "xong" ke ca khi
# khong co SA nao - va nguoi doc phai tu di tim tiep. Ket luan phai
# nam o cuoi file ma ho vua mo.
########################################
echo "=== cho IKE SA (toi da 60 giay) ==="
for _ in $(seq 1 12); do
  if strongswan status 2>/dev/null | grep -q ESTABLISHED ||
    ipsec status 2>/dev/null | grep -q ESTABLISHED; then
    echo "=== IKE SA DA LEN ==="
    strongswan status 2>/dev/null || ipsec status
    echo "=== xong ==="
    exit 0
  fi
  sleep 5
done

echo "=== IKE SA CHUA LEN. 40 dong nhat ky cua $UNIT: ==="
journalctl -u "$UNIT" -n 40 --no-pager || true
echo
echo "Doc theo thu tu: 'no matching peer config' la sai leftid;"
echo "'retransmit' lap lai ma khong co gi khac la goi tin khong toi"
echo "duoc AWS (kiem security group); 'NO_PROPOSAL_CHOSEN' la lech"
echo "bo thuat toan o dong ike=/esp= trong ipsec.conf."
echo "=== xong, chay vpn-check de xem trang thai ==="
