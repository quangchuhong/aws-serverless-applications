########################################
# cp -n terraform.tfvars.example terraform.tfvars
#
# PIPELINE VENDING ACCOUNT - chay o ACCOUNT MANAGEMENT.
#
# `-n` co chu dich: mot lan cp de len tfvars cua layer da apply la
# mot plan doi xoa nhung thu dang chay.
########################################

# MAC DINH TAT.
#
# Bat cai nay khong phai la them vai resource. No tao mot duong TU
# DONG co quyen apply bon layer, trong do co layer network - tuc
# duong co the sua TGW, firewall va moi VPC cua to chuc.
#
# Doc README truoc, nhat la muc "Ba thu pipeline nay khong lam".
enable = false

region      = "ap-southeast-1"
project     = "qh11-lz"
cost_center = "CC-0000"
owner       = "platform@example.com"

########################################
# 1. NGUON
#
# CodeCommit: AWS ngung nhan khach hang MOI tu giua 2024, nhung
# account da co repo tu truoc van dung binh thuong. Kiem:
#   aws codecommit list-repositories --region ap-southeast-1
########################################

# LUU Y: repo nay phai chua CA BO landing-zone/, khong chi layer
# pipeline. Buildspec `cd landing-zone/network`, `cd
# landing-zone/account-baseline`... nen mot repo chi co code pipeline
# se hong ngay o lenh cd dau tien cua stage A.
#
# Repo tren GitHub va repo CodeCommit la HAI BAN SAO. Commit vao
# GitHub KHONG kich hoat pipeline. Day ca hai:
#   git remote add codecommit https://git-codecommit.ap-southeast-1.amazonaws.com/v1/repos/diy-aws-landing-zone
#   git push codecommit main
source_type     = "codecommit"
repository_name = "diy-aws-landing-zone"
branch_name     = "main"

########################################
# 2. STATE
#
# PHAI khop chinh xac. Sai khoa thi Terraform mo mot state RONG:
# plan doi tao lai toan bo, va ha tang that thanh mo coi - van chay,
# van tinh tien, khong con ai quan.
#
#   cd ../tf-backend && terraform output bucket
#   cd ../tf-backend && terraform output lock_table
#   cd ../tf-backend && terraform output layers
#
# CHU Y layer network: khoa cua no KHONG khop duong dan, day la di
# san tu hoi no con nam o demo/network-lz-full. Dung doan.
########################################

state_bucket     = "qh11-lz-tfstate-609320954321"
state_lock_table = "qh11-lz-tfstate-lock"

layer_keys = {
  "landing-zone/account-baseline" = "account-baseline/terraform.tfstate"
  "landing-zone/network"          = "demo-network-lz-full/terraform.tfstate"
  "landing-zone/config-detective" = "config-detective/terraform.tfstate"
  "landing-zone/permission-sets"  = "permission-sets/terraform.tfstate"
}

########################################
# 3. SANG ACCOUNT MANG
#
# Hai layer tro vao nhau, nen lan dau phai apply BA luot:
#
#   1. layer nay, network_deploy_role_arn = ""
#      -> terraform output codebuild_role_arn
#   2. layer network, pipeline_trusted_role_arns = [ARN vua lay]
#      -> terraform output pipeline_deploy_role_arn
#   3. layer nay lan nua, dien hai dong duoi day
#
# DE RONG = bo hai stage network. Bon stage con lai van chay, va
# buoc 2 voi buoc 5 lam tay theo doc 27. Do la mot lua chon hop le -
# no danh doi tu dong hoa lay mot ban kinh thiet hai nho hon nhieu.
########################################

network_deploy_role_arn = ""
# network_deploy_role_arn = "arn:aws:iam::436908791055:role/quh11-net-pipeline-deploy"

# Stage cho attachment hoi trang thai tren TGW nay.
#   cd ../network && terraform output -raw transit_gateway_id
transit_gateway_id = ""
# transit_gateway_id = "tgw-0407992ad425893db"

########################################
# 3b. SANG CAC ACCOUNT THANH VIEN (stage E)
#
# config-detective co HAI provider alias assume
# OrganizationAccountAccessRole o account security va log archive.
# Thieu hai ARN nay thi stage E dung lai voi "Cannot assume IAM Role".
#
# Lay account ID:
#   cd ../config-detective && grep -E 'security_account_id|log_archive_account_id' terraform.tfvars
#
# DOC KY: OrganizationAccountAccessRole la ADMIN DAY DU o account
# dich. Khai o day nghia la pipeline co toan quyen o hai account do.
# Danh sach nay khong tao ra quyen - truoc no, policy cap
# sts:AssumeRole tren "*", tuc moi account trong to chuc - nhung no
# bat moi lan mo rong phai di qua mot dong doc duoc.
########################################

member_assume_role_arns = []
# member_assume_role_arns = [
#   "arn:aws:iam::458195083898:role/OrganizationAccountAccessRole",  # security
#   "arn:aws:iam::654560867047:role/OrganizationAccountAccessRole",  # log archive
# ]

########################################
# 4. DUYET
#
# Moi dia chi nhan mot thu tu SNS va PHAI BAM XAC NHAN. Truoc do
# subscription o PendingConfirmation va khong nhan gi - Terraform van
# bao tao thanh cong.
#
# De rong thi cong duyet VAN chan pipeline, chi la khong ai duoc bao.
# Mot pipeline dung im cho duyet ma khong goi ai se bi coi la hong.
########################################

approval_emails = []
# approval_emails = ["platform@example.com", "netops@example.com"]

########################################
# STAGE NAO DUNG LAI CHO NGUOI BAM
#
# MAC DINH chi "A-tao-account" - stage duy nhat gan nhu khong hoan tac
# duoc. Email la duy nhat vinh vien o pham vi AWS toan cau, va account
# chi dong duoc chu khong xoa duoc.
#
# Nam stage con lai tu apply. Doi lai chung mang FAIL_ON_DESTROY=yes:
# plan co resource bi XOA hoac THAY THE se dung ngay o buoc plan, chua
# apply gi. Mot canh bao chi co gia tri khi co nguoi doc; khong co
# nguoi doc thi no phai thanh mot lan tu choi.
#
# Muon quay lai duyet tung buoc:
#   approve_stages = ["A-tao-account","B-chia-se-tgw","C-mang-nen",
#                     "D-noi-route-table","E-config-detective",
#                     "F-permission-sets"]
########################################

approve_stages = ["A-tao-account"]

########################################
# CHO CONFIG RECORDER TRUOC STAGE E
#
# Stage E khai org config rule. Rule do hong neu MOT account trong
# pham vi khong co configuration recorder:
#
#   Account ID (353007002364): NoAvailableConfigurationRecorder
#
# Recorder do StackSet cua layer config-detective tu trien khai khi
# account vao OU - nhung lan dau no HONG, vi bucket snapshot o account
# log-archive chua cho account moi ghi. Bucket policy do liet ke tung
# account (AWS:SourceAccount, khong dung duoc dieu kien to chuc) va
# chi day du sau khi chinh stage E apply.
#
# Vong phu thuoc do khong sap xep lai duoc. Action Cho_recorder thu
# lai MOT lan roi cho toi khi moi stack instance o CURRENT.
#
# Lay ten:
#   cd ../config-detective && terraform output sweep_stack_set
# LUU Y project cua layer do co the KHAC project cua layer nay.
#
# DE RONG = bo action cho, va moi account prod moi se can mot buoc tay.
########################################

recorder_stack_set_name = ""
# recorder_stack_set_name = "quh11-lz-config-recorder"
wait_recorder_minutes   = 15

########################################
# 5. NGUONG
########################################

# Layer network apply mat ~20-30 phut khi dung ca Network Firewall.
build_timeout_minutes = 60

# Cho attachment sang `available` giua stage C va D. Stage cho HOI
# trang thai that, khong ngu mot khoang co dinh.
wait_attachment_minutes = 10

log_retention_days = 90
