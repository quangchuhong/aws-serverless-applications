########################################
# cp -n terraform.tfvars.example terraform.tfvars
#
# PIPELINE VAN HANH - chay o ACCOUNT MANAGEMENT.
#
# `-n` co chu dich: mot lan cp de len tfvars cua layer da apply la mot
# plan doi xoa nhung thu dang chay.
########################################

# MAC DINH TAT.
#
# Bat cai nay tao mot duong TU DONG co quyen sua SCP cua ca to chuc.
# SCP la tran quyen cho MOI account - mot thay doi sai o day khong lam
# gi "hong", no chi lam mot viec truoc day bi chan gio chay duoc. Kieu
# su co do khong co trieu chung.
#
# Doc README truoc, nhat la muc "Khong co cong duyet".
enable = false

region      = "ap-southeast-1"
project     = "qh11-lz"
cost_center = "CC-0000"
owner       = "platform@example.com"

########################################
# 1. NGUON
#
# CUNG repo, CUNG nhanh voi vending-pipeline. Hai pipeline cung nghe
# mot nhanh, va moi commit kich hoat CA HAI - do la chu y:
#
#   vending  moi stage ra "KHONG CO THAY DOI" khi catalog account
#            khong doi
#   ops      moi stage ra "KHONG CO THAY DOI" khi catalog ops khong doi
#
# Mot luot chay rong la nhanh va gan nhu mien phi. Doi lai, khong co
# chuyen mot commit di vao pipeline nay ma khong di vao pipeline kia -
# tuc khong co chuyen hai pipeline doc hai phien ban code khac nhau.
########################################

source_type     = "codecommit"
repository_name = "diy-aws-landing-zone"
branch_name     = "main"

########################################
# 2. STATE
#
# PHAI khop chinh xac. Sai khoa thi Terraform mo mot state RONG, va
# buildspec dung lai o chot chan "state RONG" - do la lop chan duy nhat
# giua mot khoa sai va mot plan doi tao lai toan bo.
#
#   cd ../tf-backend && terraform output bucket
#   cd ../tf-backend && terraform output lock_table
#   cd ../tf-backend && terraform output layers
########################################

state_bucket     = "qh11-lz-tfstate-609320954321"
state_lock_table = "qh11-lz-tfstate-lock"

layer_keys = {
  "landing-zone/organization" = "organization/terraform.tfstate"
}

########################################
# 3. KHO tfvars - DUNG CHUNG voi vending-pipeline
#
#   cd ../vending-pipeline && terraform output -raw tfvars_bucket
#
# Vi sao dung chung chu khong tao kho rieng: hai kho la hai cho phai
# day file, va mot kho cu la mot ban plan SAI ma khong co loi nao.
#
# SAU KHI DAT BIEN NAY, PHAI THEM LAYER VAO push-tfvars.sh:
#
#   cd ../vending-pipeline
#   grep -n 'landing-zone/' push-tfvars.sh
#
# Thieu buoc do thi khong co loi luc day - chi co loi luc pipeline
# chay, va no noi ve S3 chu khong noi ve script.
########################################

tfvars_bucket = ""
# tfvars_bucket = "qh11-lz-vending-tfvars-609320954321"

########################################
# 4. PHAT HIEN DRIFT
#
# Mot lan `terraform plan -lock=false` theo lich. KHONG bao gio apply -
# buildspec cua no khong co nhanh apply nao.
#
# Day co the la phan gia tri nhat cua ca layer: ops la cho DRIFT xay
# ra. Ai do mo mot port trong console, go mot Config rule, sua mot
# assignment bang tay. Mot lan plan hang dem ma KHONG ra "khong co
# thay doi" chinh la bao dong.
#
# Mac dinh 19:00 UTC = 2 gio sang Viet Nam: sau gio lam, va ket qua co
# nguoi doc vao buoi sang.
########################################

drift_cron = "cron(0 19 * * ? *)"

# CACH DUOC KHUYEN: khai dia chi, layer nay tu tao topic o account
# management. Khong co phu thuoc lien account nao.
#
# Moi dia chi nhan mot thu tu SNS va PHAI BAM XAC NHAN. Truoc do
# subscription o PendingConfirmation va khong nhan gi - Terraform van
# bao tao thanh cong.
drift_emails = []
# drift_emails = ["DIA-CHI-CUA-BAN@example.com"]

# Cach kia: dung mot topic CO SAN. Loai tru voi drift_emails.
#
# NEU TOPIC O ACCOUNT KHAC thi phai TU them statement cho phep role cua
# layer nay publish - Terraform o day khong sua duoc resource policy
# cua topic o account khac. Topic cua config-detective nam o account
# security va chi cho Principal = events.amazonaws.com, nen mot ARN tro
# sang do se bi tu choi, va loi duy nhat la mot dong canh bao trong log
# luc 2 gio sang.
#
# LAY ARN THAT, DUNG GO TAY:
#   cd ../config-detective && terraform output alert_topic
drift_topic_arn = ""

########################################
# 5. NGUONG
########################################

# Layer organization apply nhanh (chi SCP), nhung `plan` refresh CA
# state - gom cay OU va tag policy.
build_timeout_minutes = 30

log_retention_days = 90

########################################
# SAU KHI APPLY
#
# KHONG can them role cua pipeline nay vao scp_exempt_role_names.
#
# SCP KHONG ap dung cho principal o account management, ke ca SCP gan
# vao Root - xem ghi chu dau scp.tf. Role CodeBuild o day song o
# management, nen ProtectOrganizationMembership khong cham toi no.
#
# Mien tru chi can khi principal nam o mot account THANH VIEN.
#
# Viec THAT SU phai lam, va chi khi dung topic o account khac:
#
#   terraform output codebuild_role_arn
#   # -> them vao extra_publisher_arns o ../config-detective/terraform.tfvars
#   cd ../config-detective && terraform apply
#
# Kiem bang phep do, khong bang state:
#
#   aws codebuild start-build --project-name <project>-ops-drift
#   # log co "Da bao ve arn:aws:sns:..."  = thong
#   # log co "khong bao duoc ve SNS"      = chua mo phia topic
########################################

########################################
# 7. LAYER KEYS - THEM KHI BAT STAGE
#
# Moi stage duoc bat phai co khoa state o day, neu khong check
# "stage_bat_thi_co_khoa_state" se keu ngay luc plan.
#
#   cd ../tf-backend && terraform output layers
#
# Pipeline nay chi vao layer organization. Cac layer khac thuoc pipeline
# cua cloudops - mot layer rieng.
########################################

########################################
# 8. HAI STAGE CUNG LAYER organization
#
# SCP, OU va tag policy CUNG mot layer, CUNG mot state. Tach o day la
# tach PHAM VI (bang -target va bang PHAM_VI trong ops-gate/gate.py),
# khong tach state.
#
# Thu tu chay: A-ou -> B-scp -> C-tagging. OU dat TRUOC SCP co ly do -
# xem mo ta cua enable_ou_stage.
########################################

# Cay OU. Doi TEN mot OU se bi FAIL_ON_DESTROY chan o stage B-scp ngay
# sau - do la co y, va do la ly do OU dat truoc SCP. Them OU moi thi
# khong vuong.
enable_ou_stage = false

# Tag policy. Hien tag_policy.enabled = false o layer organization nen
# hai resource nay co 0 instance - mot stage luon xanh ma khong kiem gi.
#   cd ../organization && terraform output tag_policy
enable_tagging_stage = false
