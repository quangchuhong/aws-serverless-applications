########################################
# BO LOC KICH HOAT
#
#   cp terraform.tfvars.example terraform.tfvars
#
# tfvars nam trong .gitignore. Layer nay chay bang TAY (no khong tu kich
# hoat chinh no), nen khong can day len s3 tfvars store.
########################################

region      = "ap-southeast-1"
project     = "qh11-lz"
cost_center = "CC-0000"
owner       = "platform@example.com"

enable = true

# Ten kho CodeCommit - KHONG phai ten repo GitHub. Bay layer khac deu
# ghi "diy-aws-landing-zone"; giu giong chung.
repository_name = "diy-aws-landing-zone"
branch_name     = "main"

########################################
# BAN DO
#
# Khoa la ten NGAN. Ten day du = "<project>-<khoa>", vi du
# "qh11-lz-ops-permission-set".
#
# Gia tri la TIEN TO CHUOI, nen dau / o cuoi la bat buoc - khong co no
# thi "landing-zone/network" bat ca "landing-zone/network-cu/".
#
# CHI KHAI PIPELINE DANG BAT. Goi ten mot pipeline chua ton tai se lam
# ham bao hong moi lan chay.
########################################
ban_do = {
  ####################################
  # VENDING: HAI VUNG, VA LY DO CA LAYER NAY TON TAI
  #
  # Truoc khi co bo loc, MOI push - ke ca sua mot dong trong docs/ - deu
  # lam pipeline vending chay ca bay stage vending account.
  #
  # Vending apply BON layer: account-baseline (stage A, C), network
  # (B, D), config-detective (E0, E), permission-sets (F). Hai vung duoi
  # day la hai vung ma "doi code thi phai co pipeline chay":
  #
  #   account-baseline/  ly do goc cua pipeline nay
  #   network/           stage B, D - ca hai assume role mang
  #
  # Vi sao KHONG tao pipeline rieng cho landing-zone/network: vending da
  # apply no bang role san co, con mot pipeline rieng con cho role lien
  # account day xuong bang StackSet. Khi co, duong dan nay chuyen sang no.
  #
  # network/ co mot thu muc con la mot layer KHAC - xem khoi `tru`.
  ####################################
  "vending" = [
    "landing-zone/account-baseline/",

    # "landing-zone/network/" - TAM BO RA, xem layer_thu_cong ben duoi.
    #
    # Ha tang mang da bi XOA HET va state cua layer do dang rong. De
    # duong dan nay trong ban do thi moi lan ai sua code mang, vending
    # chay va DUNG DO o stage B: buildspec co chot chan state rong.
    #
    # Mot pipeline do thuong truc la thu nguoi ta quen mat roi thoi doc,
    # va luc do no khong con bao duoc gi nua. Mo lai dong nay ngay sau
    # khi mang duoc dung lai.
  ]

  ####################################
  # SCP + OU + tag policy. Ba stage, mot layer.
  #
  # ops-gate/ co o day vi cung ly do nhu ba pipeline duoi - va o day ly
  # do do manh hon ca: day la pipeline SCP, tuc noi gate.py doc ra nhung
  # thu nang nhat (xoa mot Deny, noi mot dieu kien). Thieu tien to nay
  # thi sua luat trong gate.py se thu lai ba pipeline kia ma KHONG thu
  # lai dung cai pipeline ma luat do quan trong nhat.
  ####################################
  "ops" = [
    "landing-zone/organization/",
    "landing-zone/ops-gate/",
  ]

  # Ai vao account nao.
  #
  # Hai tien to: layer permission-sets la thu no apply, con ops-gate la
  # bo phan loai ban plan ma MOI pipeline dung. Sua gate.py ma khong chay
  # lai pipeline nao nghia la luat moi chua bao gio duoc thu.
  "ops-permission-set" = [
    "landing-zone/permission-sets/",
    "landing-zone/ops-gate/",
  ]

  ####################################
  # HAI PIPELINE VUA BAT (cai thu ba con cho - xem cuoi khoi)
  #
  # Chung dung role OrganizationAccountAccessRole o account dich - quyet
  # dinh tam thoi, co y, se thu hep sau. Xem tfvars cua tung caller.
  #
  # THU TU BAT, va chieu nay quan trong:
  #
  #   1. apply ba caller pipeline  (pipeline ton tai o AWS)
  #   2. apply layer NAY           (ban do biet ten chung)
  #
  # Lam nguoc lai thi phep kiem 3 cua loc.py bao hong moi lan chay -
  # ban do goi ten pipeline chua ton tai.
  #
  # Lam DUNG thu tu thi giua hai buoc, kiem_do_phu bao hong moi lan chay:
  # pipeline co that ma khong co trong ban do. Ca hai chieu deu ON AO,
  # khong chieu nao im lang - nen cu lam lien hai buoc.
  #
  # ops-gate/ co trong ca hai: gate.py la bo phan loai ban plan ma MOI
  # pipeline dung. Sua luat trong do ma khong chay lai pipeline nao nghia
  # la luat moi chua bao gio duoc thu.
  ####################################
  "ops-config-rules" = [
    "landing-zone/config-detective/",
    "landing-zone/ops-gate/",
  ]

  "ops-trail" = [
    "landing-zone/org-trail/",
    "landing-zone/ops-gate/",
  ]

  # ops-network: CHUA bat.
  #
  # State cua landing-zone/network/ops dang rong (layer cha tung bi xoa),
  # nen pipeline do se dung o chot chan state rong cua buildspec. Mo dong
  # nay KHI VA CHI KHI da apply pipeline do - ten mot pipeline chua ton
  # tai lam loc.py bao hong moi lan chay (phep 3).
  #
  # Khi mo: xoa "landing-zone/network/ops" khoi layer_thu_cong ben duoi.
  # "ops-network" = ["landing-zone/network/ops/", "landing-zone/ops-gate/"]
}

########################################
# DO PHU
#
# BAT: ham liet ke pipeline that o AWS moi lan chay, va bao HONG neu co
# cai nao mang tien to "qh11-lz-" ma khong co trong ban_do.
#
# Do la chieu hong nguy hiem nhat cua ca thiet ke nay: mot pipeline da
# tat rule rieng va bi quen trong ban_do thi khong con duong nao den no.
# No van ton tai, van xanh, va khong bao gio chay nua.
########################################
kiem_do_phu = true

########################################
# LAYER CO CHU DICH KHONG CO DUONG TU DONG
#
# Layer duoc mot pipeline APPLY nhung khong duong dan nao trong ban_do
# cham toi. Phai VIET RA kem ly do - mot layer khong ai apply thi khong co
# trieu chung nao.
#
# kiem-module.py phep 10 doi chieu: moi `layer = "..."` khai trong cac
# caller pipeline phai duoc mot tien to trong ban_do CUA CHINH pipeline do
# cham toi, neu khong thi phai co ten o day. Phep kiem do so theo TUNG
# pipeline chu khong gop tien to - neu gop thi network/ops trong nhu da
# duoc phu boi tien to "landing-zone/network/" cua vending, trong khi
# vending khong apply layer do.
#
# ------------------------------------------------------------------
# HAI MUC, VA CA HAI LA TRANG THAI QUA DO
#
# Ha tang mang da bi XOA HET. Ca hai layer duoi day co state RONG:
#
#   landing-zone/network       vending apply o stage B, D
#   landing-zone/network/ops   ops-pipeline-network (dang tat)
#
# Buildspec co chot chan state rong, nen de chung trong ban do chi tao ra
# mot pipeline do thuong truc - thu nguoi ta quen mat roi thoi doc.
#
# TRINH TU DUNG LAI, va bo thu tu thi mot trong hai phep kiem cua loc.py
# se keu:
#
#   1. dung lai landing-zone/network (bang tay, hoac vending voi
#      FIRST_APPLY=yes)
#   2. mo lai "landing-zone/network/" trong ban do cua vending
#   3. apply landing-zone/network/ops mot lan bang tay
#   4. bat ops-pipeline-network
#   5. mo dong "ops-network" trong ban do
#   6. xoa CA HAI muc nay
#
# Buoc 2 va 5 la hai buoc de quen nhat, vi bo qua chung khong gay loi -
# chi lam mot layer khong con duong tu dong. Do la ly do danh sach nay
# ton tai.
#
# ------------------------------------------------------------------
# ------------------------------------------------------------------
# config-detective khong con o day nua: no da co pipeline rieng
# (ops-pipeline-config-rules) trong ban_do o tren. Truoc do no o day vi
# vending apply no o stage E0/E ma khong duoc kich hoat boi thay doi cua
# chinh no - tuc thay doi nam cho toi lan vend account tiep theo roi duoc
# apply kem mot viec chang lien quan.
########################################
layer_thu_cong = [
  # Ha tang mang da bi xoa het; ca hai layer nay dang co state RONG va se
  # duoc dung lai sau. Ca hai deu phai mo lai khi den luc - xem trinh tu
  # o khoi chu thich tren.
  "landing-zone/network",
  "landing-zone/network/ops",
]

########################################
# TRU RA - LAYER LONG NHAU
#
# landing-zone/network/ops la layer RIENG (pipeline rieng, state rieng)
# nhung nam BEN TRONG landing-zone/network. So khop la so khop CHUOI, nen
# tien to "landing-zone/network/" cua vending cung bat moi file trong
# "network/ops/".
#
# Khong tru ra thi moi lan sua lop van hanh mang - thu doi HANG NGAY - se
# keo vending chay vo ich, kem mot cong duyet treo mang nhan
# "A-tao-account". Do khong phai loi, chi la on; va on lau thi nguoi ta
# thoi doc.
#
# Khi ops-pipeline-network bat len, duong dan nay thuoc ve no - dong tru
# o day VAN dung va van can.
########################################
tru = {
  "vending" = ["landing-zone/network/ops/"]
}

########################################
# BAO KHI BO LOC HONG
#
# Dia chi phai bam xac nhan trong email SNS gui, neu khong thi topic co
# ma khong ai nhan - va do lai la mot cai im lang nua.
########################################
loi_emails = ["platform@example.com"]
# loi_topic_arn = "arn:aws:sns:ap-southeast-1:111122223333:topic-co-san"

log_retention_days = 90
