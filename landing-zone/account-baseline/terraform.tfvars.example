########################################
# cp terraform.tfvars.example terraform.tfvars
#
# ACCOUNT BASELINE - thay cho AFT o ban DIY.
# Chay o MANAGEMENT ACCOUNT.
########################################

enable = false

region      = "ap-southeast-1"
project     = "acme-lz"
cost_center = "CC-0000"
owner       = "platform@example.com"

########################################
# 1. Quet default VPC
#
# Lay OU ID: cd ../organization && terraform output ou_ids
#
# DUA VAO DAY MOI OU chua account thuc, ke ca Sandbox va
# Non-Production - khac han config-detective.
#
# Config tinh tien theo khoi luong nen phai chon loc. Xoa
# default VPC thi mien phi va lam mot lan, nen bo sot mot OU
# chi de lai lo hong chu khong tiet kiem duoc gi.
########################################

baseline_target_ous = [
  # "ou-xxxx-security",
  # "ou-xxxx-infrastructure",
  # "ou-xxxx-non-production",
  # "ou-xxxx-production",
  # "ou-xxxx-sandbox",
]

# PHAI khop voi allowed_regions ben layer organization.
# region_lock SCP chan ca ec2:DeleteVpc o region ngoai danh sach do,
# nen Lambda se ghi "SKIP" cho chung. Do khong phai lo hong - xem
# mo ta bien sweep_regions.
sweep_regions = ["ap-southeast-1", "us-east-1"]

# Doi gia tri nay de BUOC quet lai o moi account.
# Custom resource cua CloudFormation chi chay lai khi thuoc tinh doi -
# them region vao sweep_regions ma khong doi cai nay thi khong co gi
# xay ra.
sweep_version = "1"

########################################
# 1b. Hardening cap account
#
# Bon thu AWS de MO SAN khi mo mot account moi. Di cung Lambda
# cua vpc-sweep - mot stack instance moi account, khong phai bon.
#
# Tat ca MIEN PHI, va tat ca deu KHONG bao loi khi thieu: mot
# account khong co cai nao trong so nay van chay hoan toan
# binh thuong.
########################################

harden_password_policy        = true
harden_s3_public_access_block = true
harden_ebs_encryption         = true
harden_default_security_group = true

password_min_length       = 14
password_max_age_days     = 90
password_reuse_prevention = 24

########################################
# 2. YEU CAU TAO ACCOUNT
#
# Account KHONG khai o day nua - chung nam trong
# catalog/accounts.yaml, mot khoi moi account, di qua PR.
#
#   ./lint.sh          <- chay TRUOC, khong can AWS
#   terraform plan
#
# =====================================================
# GAN NHU KHONG HOAN TAC DUOC.
#
# Account khong xoa duoc, chi dong duoc, va dong xong
# phai cho 90 ngay. Email la DUY NHAT VINH VIEN - dong
# account roi cung khong dung lai duoc email do.
# =====================================================
#
# TEN OU -> OU ID. Catalog khai bang TEN; day la cho giai
# ten thanh ID.
#
# Lay: cd ../organization && terraform output ou_ids
########################################

ou_ids = {
  # Infrastructure = "ou-xxxx-infrastructure"
  # Security       = "ou-xxxx-security"
  # NonProd        = "ou-xxxx-non-production"
  # Prod           = "ou-xxxx-production"
  # Analytics      = "ou-xxxx-analytics"
  # Sandbox        = "ou-xxxx-sandbox"
}

# Duong CU, giu lai cho account tao TRUOC khi co catalog.
# No DE LEN catalog; khai o ca hai cho thi plan dung lai.
create_accounts = {}

########################################
# 2b. Mang nen cho account workload
#
# Account co khoi `network` trong catalog nhan mot VPC dung
# theo doc 17: 4 subnet, TGW attachment, DNS tap trung,
# gateway endpoint S3/DynamoDB.
#
# Lay handle:
#   cd ../network && terraform output -raw paste_network_handles
#
# De RONG thi VPC van duoc tao nhung KHONG noi vao luoi -
# khong TGW, khong DNS tap trung. check khi plan noi ra
# truong hop do, chu khong de no im lang.
########################################

network_handles = {
  # transit_gateway_id = "tgw-xxxxxxxxxxxxxxxxx"
  # dns_profile_id     = "rp-xxxxxxxxxxxxxxxx"
  # internal_supernet  = "10.0.0.0/8"
}

# De rong = lay hai AZ dau cua region.
availability_zones = []

# false = terraform destroy chi go khoi state, KHONG dong account.
# Giu false tru khi that su co y do.
close_accounts_on_destroy = false

########################################
# 3. Ban do pham vi
#
# Dung de SINH cau hinh cho layer khac, va de canh bao khi
# co account chua duoc khai o dau ca.
#
#   analytics | nonprod | prod | none
#
# "none" = account ha tang (network, security, log archive):
# chi nhan permission set pham vi "all".
#
# Sau khi apply:
#   terraform output -raw paste_permission_sets
#   terraform output -raw paste_config_detective
#   terraform output unmapped_accounts
########################################

account_scopes = {
  # "222222222222" = "none"       # lz-network
  # "333333333333" = "none"       # lz-security
  # "444444444444" = "none"       # lz-logarchive
  # "555555555555" = "nonprod"    # lz-app-dev
  # "666666666666" = "prod"       # lz-app-prod
}
