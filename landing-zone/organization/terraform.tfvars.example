########################################
# cp terraform.tfvars.example terraform.tfvars
#
# BAN DIY - ban dung that cho lab.
# Ban Control Tower de doi chieu o ../control-tower/.
#
# Chay o MANAGEMENT ACCOUNT.
########################################

region      = "ap-southeast-1"
project     = "acme-lz"
cost_center = "CC-0000"
owner       = "platform@example.com"

########################################
# 1. Terraform co quan ly organization khong
#
# LAN DAU, kiem tra truoc khi chon:
#   aws organizations describe-organization
#
#   Bao loi     -> dat true  (chua co, Terraform tao moi)
#   Ra ket qua  -> de false  (da co, Terraform chi doc)
#
# Da co ma dat true = AlreadyInOrganizationException.
#
# ---------------------------------------------------------------
# SAU KHI DA APPLY VOI true THI GIU true MAI MAI.
#
# Doi ve false luc organization da nam trong state = Terraform len
# ke hoach XOA organization (count 1 -> 0). prevent_destroy se chan
# lai voi "Instance cannot be destroyed" - do la chan dung.
#
# That su muon chuyen sang chi doc thi go khoi state truoc:
#   terraform state rm 'aws_organizations_organization.this[0]'
# ---------------------------------------------------------------
########################################

create_organization = false

########################################
# 2. Region duoc phep
#
# PHAI co us-east-1 - CloudFront, WAF scope CLOUDFRONT, ACM cho
# CloudFront va nhieu API billing chi ton tai o day.
#
# Cang it region cang tot: resource o region ban khong nhin toi la
# thu de bi bo quen nhat.
########################################

allowed_regions = ["ap-southeast-1", "us-east-1"]

########################################
# 3. Account mang
#
# Chi account nay duoc tao IGW / NAT / EIP / TGW.
# De rong o giai doan dau khi chua tach account.
########################################

network_account_id = ""
# network_account_id = "222222222222"

########################################
# 4. Bat SCP
#
# KHUYEN NGHI: bat TUNG CAI MOT.
#
# Buoc 1 - chi baseline, apply, thu lai thao tac binh thuong
# Buoc 2 - them region_lock
# Buoc 3 - them network_lock
# Buoc 4 - them prod_guard
#
# Bat het mot luot roi co gi hong thi khong biet do cai nao.
########################################

enable_scp = {
  baseline     = true
  region_lock  = false
  network_lock = false
  prod_guard   = false
}

# TAO policy nhung KHONG GAN vao dau.
# Dung de doc noi dung tren console truoc khi that su chan.
scp_dry_run = true

########################################
# 5. Mien tru
#
# Role duoc mien khoi baseline va region lock.
#
# De RONG neu chua chac. Them sau de hon la go ra sau - go mot
# mien tru nghia la co thu dang chay se hong.
########################################

scp_exempt_role_names = []
# scp_exempt_role_names = ["lz-cicd-deploy", "AWSControlTowerExecution"]

# ---------------------------------------------------------------
# CAN THIET NEU DUNG landing-zone/config-detective
#
# baseline SCP chan config:DeleteConfigurationRecorder va
# config:DeleteDeliveryChannel - dung y do, khong ai duoc tat audit
# trail. Nhung no chan luon CLOUDFORMATION ROLLBACK: mot lan trien
# khai StackSet that bai la de lai stack DELETE_FAILED khong go duoc,
# va khong ai co quyen don.
#
# Mien tru role ma StackSet dung o account thanh vien:
#
#   "stacksets-exec-*"
#
# KHONG phai AWSServiceRoleForCloudFormationStackSetsOrgMember - do la
# service-linked role o phia quan tri. Role that su THUC THI stack o
# account thanh vien ten "stacksets-exec-<hash>", hash sinh theo to
# chuc. Dung wildcard vi hash khong doan truoc duoc; exempt_condition
# dung ArnNotLike nen hieu dau *.
#
# Xem ten that:
#   aws iam list-roles --profile <member> \
#     --query 'Roles[?starts_with(RoleName,`stacksets-exec`)].RoleName'
#
# Hoac doc thang trong StatusReason cua stack instance khi no bi tu
# choi - dong "assumed-role/<ten>/..." chinh la no.
# ---------------------------------------------------------------

########################################
# 6. Delegated administrator
#
# DIEU KIEN TIEN QUYET CUA landing-zone/config-detective.
# De RONG cho den khi thuc su dung toi layer do.
#
# ---------------------------------------------------------------
# GAN NHU KHONG DAO NGUOC: moi dich vu chi co MOT delegated admin,
# va doi sang account khac khi da co member dang enable la rat kho
# (voi GuardDuty thi khong doi duoc). Chon MOT LAN, chon dung.
# ---------------------------------------------------------------
#
# HAI DONG config LA HAI SERVICE PRINCIPAL KHAC NHAU va deu can.
# Thieu config-multiaccountsetup thi
# aws_config_organization_managed_rule bao AccessDeniedException ma
# KHONG noi ro thieu gi. Co check block bat viec nay.
########################################

delegated_administrators = {}

# delegated_administrators = {
#   "config.amazonaws.com"                   = "333333333333"  # security account
#   "config-multiaccountsetup.amazonaws.com" = "333333333333"  # PHAI co ca dong nay
#   "securityhub.amazonaws.com"              = "333333333333"
# }

