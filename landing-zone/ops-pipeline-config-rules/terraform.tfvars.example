########################################
# cp -n terraform.tfvars.example terraform.tfvars
#
# PIPELINE: CONFIG RULE
########################################

# MAC DINH TAT - can role rieng o account SECURITY truoc. Xem versions.tf.
enable = true

########################################
# DUONG KICH HOAT
#
# false = pipeline nay KHONG co rule EventBridge rieng; no chi chay khi
# landing-zone/trigger-filter goi ten no.
#
# Dat false vi trigger-filter DA BAT. De true thi ca hai duong cung no:
# pipeline chay hai lan moi push (vo hai) va bo loc thanh vo nghia.
#
# THU TU: ten pipeline nay phai co trong ban_do cua trigger-filter. Thieu
# o do thi khong con duong nao kich hoat no - nhung kiem_do_phu se bao
# hong moi lan chay, nen cho trong do khong im lang.
########################################
tu_kich_hoat = false

region      = "ap-southeast-1"
project     = "qh11-lz"
cost_center = "CC-0000"
owner       = "platform@example.com"

source_type     = "codecommit"
repository_name = "diy-aws-landing-zone"
branch_name     = "main"

########################################
# STATE - PHAI KHOP CHINH XAC
#
# Sai khoa thi Terraform mo mot state RONG, va buildspec dung lai o chot
# chan "state RONG" - do la lop chan duy nhat giua mot khoa sai va mot
# plan doi tao lai toan bo.
#
#   cd ../tf-backend && terraform output bucket
#   cd ../tf-backend && terraform output layers
########################################

state_bucket     = "qh11-lz-tfstate-609320954321"
state_lock_table = "qh11-lz-tfstate-lock"

########################################
# KHO tfvars - DUNG CHUNG voi cac pipeline khac
#
#   cd ../vending-pipeline && terraform output -raw tfvars_bucket
#
# SAU KHI DAT BIEN NAY, PHAI THEM LAYER VAO push-tfvars.sh:
#   cd ../vending-pipeline && grep -n 'landing-zone/' push-tfvars.sh
#
# Thieu buoc do thi khong co loi luc day - chi co loi luc pipeline chay,
# va no noi ve S3 chu khong noi ve script.
########################################

tfvars_bucket = "qh11-lz-vending-tfvars-609320954321"

########################################
# DRIFT
#
# Day co the la phan gia tri nhat cua ca layer: mot lan plan hang dem ma
# KHONG ra "khong co thay doi" chinh la bao dong.
########################################

drift_cron = "cron(0 19 * * ? *)"
# CACH DUOC KHUYEN: khai dia chi, layer nay TU TAO topic o account
# management. Khong co phu thuoc lien account nao.
#
# Moi dia chi nhan mot thu tu SNS va PHAI BAM XAC NHAN. Truoc do
# subscription o PendingConfirmation va khong nhan gi - Terraform van bao
# tao thanh cong.
drift_emails = []
# drift_emails = ["DIA-CHI-CUA-BAN@example.com"]

########################################
# CACH KIA: MOT TOPIC CO SAN - VA VI SAO DONG NAY GIO DE RONG
#
# File nay TRUOC DAY dat san mot ARN tro sang topic cua config-detective o
# account security. Do la mot cai bay ba lop, va ca ba deu im lang:
#
#   1. LIEN ACCOUNT. notify.tf cua module viet ro: resource policy cua
#      topic do chi cho Principal = events.amazonaws.com. Publish lien
#      account can CA HAI phia cho phep, va Terraform o day KHONG sua duoc
#      policy cua mot topic o account khac. Nen buoc drift chay, phat hien
#      dung, roi in "CANH BAO: khong bao duoc ve SNS" - moi dem, trong log
#      cua mot job khong ai mo. Mot canh bao khong den duoc dich TE HON
#      khong co canh bao, vi no tao cam giac da co nguoi canh.
#
#   2. LOAI TRU VOI drift_emails. drift_topic_arn THANG, nen them mot dong
#      `drift_emails = [...]` se KHONG tao topic nao va nhung dia chi do
#      khong nhan gi. Check "khong_khai_ca_hai_nguon_topic" bat viec nay -
#      nhung check block chi CANH BAO, no khong bao gio lam apply do. Va
#      dong canh bao nay da co san o day tu truoc ma van co nguoi khai ca
#      hai: mot chu thich KHONG THUC THI.
#
#   3. ARN GO TAY. Ten trong ARN cu la "quh11-lz-..." - go sai tu "qh11".
#      Mot ARN go sai khong lam apply do: publish that bai luc 2 gio sang.
#
# Nen: neu dung topic co san thi LAY ARN THAT, DUNG GO TAY:
#   cd ../config-detective && terraform output alert_topic
#
# Va neu topic o account khac, phai TU them statement cho phep role
# <project>-<ten>-codebuild publish. Kiem policy hien tai:
#   aws sns get-topic-attributes --topic-arn <arn> \
#     --query 'Attributes.Policy' --output text
########################################
drift_topic_arn = ""

build_timeout_minutes = 30
log_retention_days    = 90

layer_keys = {
  "landing-zone/config-detective" = "config-detective/terraform.tfstate"
}

enable_config_rules_stage = true

########################################
# ROLE LIEN ACCOUNT
#
# RONG la dung khi chua co role rieng. Hom nay o account security chi co
# OrganizationAccountAccessRole = FULL ADMIN, va cap cho pipeline quyen
# assume vao do de sua Config rule la cap quyen sua moi thu trong account
# bao mat.
########################################

# DIEN TRUOC KHI BAT STAGE. Danh sach rong lam Resource cua statement
# sts:AssumeRole thanh [], va IAM tu choi CA POLICY - loi chi den luc
# apply, khong hien o plan. Check "bat_stage_thi_co_role" bat som hon.
#
# Quyet dinh tam thoi da thong qua: dung OrganizationAccountAccessRole
# truoc, thu hep sau bang session policy.
#
# Lay account id tu tfvars cua layer tuong ung (config-detective):
#   grep account_id ../config-detective/terraform.tfvars
config_pipeline_role_arns = [
  # "arn:aws:iam::<security_account_id>:role/OrganizationAccountAccessRole",
  # "arn:aws:iam::<log_archive_account_id>:role/OrganizationAccountAccessRole",
]

########################################
# ARN BUOC VERIFY DUNG DE DOC - VA VI SAO NO TACH RIENG
#
# Buoc Verify chay ./landing-zone/config-detective/kiem-config.sh, doc lai
# organization config rule TU AWS sau khi apply. Ba thu no doc duoc ngay:
# rule co ton tai, ExcludedAccounts co ai moi khong, rule da rai xuong
# tung account chua. (Trang thai TUAN THU thi khong - Config danh gia theo
# lich, ngay sau apply gan nhu luon INSUFFICIENT_DATA.)
#
# VI SAO KHONG TAI SU DUNG config_pipeline_role_arns: danh sach do co HAI
# ARN (security va log-archive). Lay phan tu dau tien la dua vao THU TU
# cua mot danh sach ma khong dong nao noi thu tu la co nghia - doi hai
# dong o tren cho nhau se lam buoc verify doc sai account trong im lang.
#
# RONG thi van chay: script doc bang danh tinh CodeBuild o management va
# IN RA rang no khong assume. Neu management khong thay rule cua delegated
# admin thi ket qua la 0 rule, va script bao LOI - "doc duoc va rong"
# khong duoc coi la "khong co gi sai".
#
# PHAI la mot trong cac ARN o config_pipeline_role_arns, neu khong thi
# statement sts:AssumeRole khong phu no va Verify do voi AccessDenied.
# check "arn_verify_nam_trong_danh_sach_assume" trong main.tf canh cho.
########################################
config_verify_role_arn = ""
# config_verify_role_arn = "arn:aws:iam::<security_account_id>:role/OrganizationAccountAccessRole"

# Config rule khong nam trong danh sach sec review (SCP, permission set,
# firewall rule). Muon them thi: ["cloudops-config-rules"]
approve_stages  = []
approval_emails = []
