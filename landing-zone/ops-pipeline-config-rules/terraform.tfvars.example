########################################
# cp -n terraform.tfvars.example terraform.tfvars
#
# PIPELINE: CONFIG RULE
########################################

# MAC DINH TAT - can role rieng o account SECURITY truoc. Xem versions.tf.
enable = true

########################################
# DUONG KICH HOAT
#
# false = pipeline nay KHONG co rule EventBridge rieng; no chi chay khi
# landing-zone/trigger-filter goi ten no.
#
# Dat false vi trigger-filter DA BAT. De true thi ca hai duong cung no:
# pipeline chay hai lan moi push (vo hai) va bo loc thanh vo nghia.
#
# THU TU: ten pipeline nay phai co trong ban_do cua trigger-filter. Thieu
# o do thi khong con duong nao kich hoat no - nhung kiem_do_phu se bao
# hong moi lan chay, nen cho trong do khong im lang.
########################################
tu_kich_hoat = false

region      = "ap-southeast-1"
project     = "qh11-lz"
cost_center = "CC-0000"
owner       = "platform@example.com"

source_type     = "codecommit"
repository_name = "diy-aws-landing-zone"
branch_name     = "main"

########################################
# STATE - PHAI KHOP CHINH XAC
#
# Sai khoa thi Terraform mo mot state RONG, va buildspec dung lai o chot
# chan "state RONG" - do la lop chan duy nhat giua mot khoa sai va mot
# plan doi tao lai toan bo.
#
#   cd ../tf-backend && terraform output bucket
#   cd ../tf-backend && terraform output layers
########################################

state_bucket     = "qh11-lz-tfstate-609320954321"
state_lock_table = "qh11-lz-tfstate-lock"

########################################
# KHO tfvars - DUNG CHUNG voi cac pipeline khac
#
#   cd ../vending-pipeline && terraform output -raw tfvars_bucket
#
# SAU KHI DAT BIEN NAY, PHAI THEM LAYER VAO push-tfvars.sh:
#   cd ../vending-pipeline && grep -n 'landing-zone/' push-tfvars.sh
#
# Thieu buoc do thi khong co loi luc day - chi co loi luc pipeline chay,
# va no noi ve S3 chu khong noi ve script.
########################################

tfvars_bucket = "qh11-lz-vending-tfvars-609320954321"

########################################
# DRIFT
#
# Day co the la phan gia tri nhat cua ca layer: mot lan plan hang dem ma
# KHONG ra "khong co thay doi" chinh la bao dong.
########################################

drift_cron      = "cron(0 19 * * ? *)"
drift_topic_arn = "arn:aws:sns:ap-southeast-1:458195083898:quh11-lz-security-findings"

# CHON MOT, KHONG PHAI CA HAI. drift_topic_arn o tren THANG, nen mot
# dong `drift_emails = [...]` them vao day se khong tao topic nao va
# nhung dia chi do khong nhan duoc gi - check "khong_khai_ca_hai_nguon_topic"
# trong module canh bao dung viec do.
#
# Bo drift_topic_arn di neu muon dung drift_emails.

build_timeout_minutes = 30
log_retention_days    = 90

layer_keys = {
  "landing-zone/config-detective" = "config-detective/terraform.tfstate"
}

enable_config_rules_stage = true

########################################
# ROLE LIEN ACCOUNT
#
# RONG la dung khi chua co role rieng. Hom nay o account security chi co
# OrganizationAccountAccessRole = FULL ADMIN, va cap cho pipeline quyen
# assume vao do de sua Config rule la cap quyen sua moi thu trong account
# bao mat.
########################################

# DIEN TRUOC KHI BAT STAGE. Danh sach rong lam Resource cua statement
# sts:AssumeRole thanh [], va IAM tu choi CA POLICY - loi chi den luc
# apply, khong hien o plan. Check "bat_stage_thi_co_role" bat som hon.
#
# Quyet dinh tam thoi da thong qua: dung OrganizationAccountAccessRole
# truoc, thu hep sau bang session policy.
#
# Lay account id tu tfvars cua layer tuong ung (config-detective):
#   grep account_id ../config-detective/terraform.tfvars
config_pipeline_role_arns = [
  # "arn:aws:iam::<security_account_id>:role/OrganizationAccountAccessRole",
  # "arn:aws:iam::<log_archive_account_id>:role/OrganizationAccountAccessRole",
]

# Config rule khong nam trong danh sach sec review (SCP, permission set,
# firewall rule). Muon them thi: ["cloudops-config-rules"]
approve_stages  = []
approval_emails = []
