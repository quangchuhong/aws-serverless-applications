########################################
# cp -n terraform.tfvars.example terraform.tfvars
#
# PIPELINE: DNS, ENDPOINT, TUONG LUA
########################################

# MAC DINH TAT - va hai stage ben duoi cung tat, vi hai ly do KHAC NHAU.
# Xem versions.tf.
enable = false

########################################
# DUONG KICH HOAT
#
# false = pipeline nay KHONG co rule EventBridge rieng; no chi chay khi
# landing-zone/trigger-filter goi ten no.
#
# Dat false vi trigger-filter DA BAT. De true thi ca hai duong cung no:
# pipeline chay hai lan moi push (vo hai) va bo loc thanh vo nghia.
#
# THU TU: ten pipeline nay phai co trong ban_do cua trigger-filter. Thieu
# o do thi khong con duong nao kich hoat no - nhung kiem_do_phu se bao
# hong moi lan chay, nen cho trong do khong im lang.
########################################
tu_kich_hoat = false

region      = "ap-southeast-1"
project     = "qh11-lz"
cost_center = "CC-0000"
owner       = "platform@example.com"

source_type     = "codecommit"
repository_name = "diy-aws-landing-zone"
branch_name     = "main"

########################################
# STATE - PHAI KHOP CHINH XAC
#
# Sai khoa thi Terraform mo mot state RONG, va buildspec dung lai o chot
# chan "state RONG" - do la lop chan duy nhat giua mot khoa sai va mot
# plan doi tao lai toan bo.
#
#   cd ../tf-backend && terraform output bucket
#   cd ../tf-backend && terraform output layers
########################################

state_bucket     = "qh11-lz-tfstate-609320954321"
state_lock_table = "qh11-lz-tfstate-lock"

########################################
# KHO tfvars - DUNG CHUNG voi cac pipeline khac
#
#   cd ../vending-pipeline && terraform output -raw tfvars_bucket
#
# SAU KHI DAT BIEN NAY, PHAI THEM LAYER VAO push-tfvars.sh:
#   cd ../vending-pipeline && grep -n 'landing-zone/' push-tfvars.sh
#
# Thieu buoc do thi khong co loi luc day - chi co loi luc pipeline chay,
# va no noi ve S3 chu khong noi ve script.
########################################

tfvars_bucket = "qh11-lz-vending-tfvars-609320954321"

########################################
# DRIFT
#
# Day co the la phan gia tri nhat cua ca layer: mot lan plan hang dem ma
# KHONG ra "khong co thay doi" chinh la bao dong.
########################################

drift_cron      = "cron(0 19 * * ? *)"
drift_topic_arn = "arn:aws:sns:ap-southeast-1:458195083898:quh11-lz-security-findings"

build_timeout_minutes = 30
log_retention_days    = 90

########################################
# LAYER MA PIPELINE NAY APPLY
#
# KHOA KHONG KHOP DUONG DAN - do KHONG phai loi go nham.
#
# Layer network/ops truoc o demo/network-lz-full va DA APPLY THAT. Khi no
# thay the landing-zone/network, duong dan doi nhung khoa state GIU
# NGUYEN. Xem khoi chu thich o tf-backend/outputs.tf.
#
# Go thanh "network-ops/terraform.tfstate" theo truc giac se mo mot state
# RONG, va plan doi tao lai ca layer.
########################################

layer_keys = {
  "landing-zone/network/ops" = "demo-network-lz-full/ops/terraform.tfstate"
}

########################################
# HAI STAGE, HAI MUC RUI RO
#
# Diem chan thu hai truoc day - "network/ops dung `profile`, CodeBuild
# khong co profile" - DA GIAI: layer gio co `dynamic "assume_role"`, sao
# chep tu layer cha, mau da chay that trong CodeBuild.
#
# CON MOT DIEU KIEN, va no phai DO chu khong doan: state cua
# network/ops KHONG duoc rong. Layer cha tung bi xoa. Do truoc khi bat:
#
#   cd ../network/ops && terraform state list | wc -l
#
# Ra 0 thi buildspec se dung lai o chot chan state rong (dung nhu the),
# va viec can lam la apply layer do mot lan bang tay truoc.
########################################

enable_network_stage  = false
enable_firewall_stage = false

# Chi FIREWALL co cong duyet. DNS thi khong - mot thay doi DNS sai co
# trieu chung ngay, con mot ingress rule moi thi khong co gi bao.
approve_stages  = ["cloudops-firewall"]
approval_emails = []

########################################
# ROLE LIEN ACCOUNT - QUYET DINH TAM THOI, CO Y
#
# KHUYEN NGHI GOC o day la: dung dien OrganizationAccountAccessRole, vi
# do la full admin trong account network con pipeline nay chi can sua DNS
# record voi rule group.
#
# Quyet dinh hien tai KHAC khuyen nghi do: dung role san co truoc de cac
# pipeline chay on, roi thu hep sau. Ghi ra day de lan sau khong ai doc
# doan tren roi tuong day la mot cho bo sot.
#
# ------------------------------------------------------------------
# VA MOT DIEU PHAI BIET RO KHI DUNG ROLE NAY
#
# Khoi tu_choi_dich_vu trong main.tf (Deny DeleteTransitGateway,
# DeleteVpc, ...) KHONG phu duoc phan chay o account network. Deny do gan
# vao role CodeBuild o account management, va sau sts:AssumeRole thi
# policy cua danh tinh goi khong di theo - phien moi mang quyen cua role
# DICH, tuc full admin.
#
# Thu con giu lai gioi han: -target cua tung stage, gate.py doc ban plan,
# va cong duyet o stage firewall. Ba thu do o phia management nen chung
# van co tac dung.
#
# Cach chua khi den luc: SESSION POLICY trong khoi assume_role cua
# provider (network/ops/versions.tf). Session policy giao voi quyen cua
# role dich, nen Deny dat o do rang buoc dung phien dang lam viec.
########################################

network_pipeline_role_arns = ["arn:aws:iam::436908791055:role/OrganizationAccountAccessRole"]

# Thu provider THUC SU assume. Phai la mot phan tu cua danh sach tren -
# check "role_assume_nam_trong_danh_sach" bat viec do luc apply.
network_deploy_role_arn = "arn:aws:iam::436908791055:role/OrganizationAccountAccessRole"
